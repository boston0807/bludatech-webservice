{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "bludatech-webservice",
	"compatibility_date": "2026-11-04",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "bludatech-webservice"
		}
	],
	  "vars": {
    "DATABASE_URL": "postgresql://postgres.priysttjarawsretgmrs:KSloP756JW1@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres",
    "JWT_EXPIRES_IN": "7d",
    "JWT_SECRET": "elevator-app-super-secret-jwt-key-2026",
    "NEXT_PUBLIC_APP_URL": "http://localhost:3000",
    "SMTP_FROM": "Bludatech <bostonkc55h4@gmail.com>",
    "SMTP_HOST": "smtp.gmail.com",
    "SMTP_PASS": "gfcu gkue kqqm rbzp",
    "SMTP_PORT": "465",
    "SMTP_SECURE": "true",
    "SMTP_USER": "bostonkc55h4@gmail.com"
  	},
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	}
}