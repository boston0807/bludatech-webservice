# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/elevator_db"

# Auth - JWT Secret (ใช้ค่า random string ยาวอย่างน้อย 32 ตัวอักษร)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email (Nodemailer - ใช้ Gmail App Password หรือ SMTP อื่น)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Elevator Service <your-email@gmail.com>"
