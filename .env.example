# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/elevator_db"

# Auth - JWT Secret (ใช้ค่า random string ยาวอย่างน้อย 32 ตัวอักษร)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email (Nodemailer - ใช้ Gmail App Password หรือ SMTP อื่น)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE=
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Elevator Service <your-email@gmail.com>"

# อีเมลทีมช่าง/พนักงานที่รับแจ้งเตือน (คั่นด้วย ,) — ตาราง Employee ไม่มีอีเมล
TECH_NOTIFY_EMAILS=""
STAFF_NOTIFY_EMAILS=""

# Cron เตือนรอบบำรุงล่วงหน้า (/api/cron/service-reminders) — ใช้ random string ยาว ≥ 16 ตัวอักษร
CRON_SECRET=""
SERVICE_DUE_NOTICE_DAYS="7"

# แจ้งเตือนวัสดุใกล้หมดเมื่อคงเหลือ (หลังหักยอดจอง) ≤ ค่านี้
LOW_STOCK_THRESHOLD="5"
