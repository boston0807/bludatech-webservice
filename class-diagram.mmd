    MaterialController ..> Material : uses
    PurchaseController ..> Material : uses
    SafetyCheckController ..> Customer : uses
    InvoiceController ..> Job : uses
    InvoiceController ..> Quotation : uses
    InvoiceController ..> Customer : uses
    InvoiceController ..> Expense : uses
    InvoiceController ..> Receipt : uses
    PaymentController ..> Job : uses
    PaymentController ..> Expense : uses
    PaymentController ..> Payment : uses
    PaymentController ..> Receipt : uses
    HistoryController ..> Job : uses
    DatabaseHandler ..> Customer : uses
    DatabaseHandler ..> Employee : uses
    DatabaseHandler ..> Job : uses
    DatabaseHandler ..> Survey : uses
    DatabaseHandler ..> Expense : uses
    DatabaseHandler ..> Quotation : uses
    DatabaseHandler ..> WorkPlan : uses
    DatabaseHandler ..> WorkPlanMaterial : uses
    DatabaseHandler ..> Material : uses
    DatabaseHandler ..> Receipt : uses
    DatabaseHandler ..> Payment : uses
    EmailService ..> Customer : uses
