---
title: Class Diagram
config:
  theme: neutral
---
classDiagram
    direction LR

    %% Interface classes
    class LoginInterface {
        -loginController
        +display(message)
        +checkEmptyFields()
        +notify(result)
    }
    class RequestInterface {
        -jobController
        +display(message)
        +checkEmptyFields()
        +notify(result)
    }
    class RegisterInterface {
        -registerController
        +display(message)
        +checkEmptyFields()
        +checkPhoneNumberAndEmailFormat()
        +notify(result)
    }
    class CustomerApprovalInterface {
        -customerController
        +display(message)
        +notify(result)
    }
    class SurveyInterface {
        -jobController
        +display(message)
        +notify(result)
    }
    class QuotationInterface {
        -quotationController
        -jobController
        +display(message)
        +notify(result)
    }
    class WorkPlanInterface {
        -workPlanController
        +display(message)
        +notify(result)
    }
    class MaterialInterface {
        -materialController
        +display(message)
    }
    class PurchaseInterface {
        -purchaseController
        +display(message)
        +notify(result)
    }
    class TechnicianJobInterface {
        -jobController
        +display(message)
        +notify(result)
    }
    class SafetyCheckInterface {
        -safetyCheckController
        +display(message)
        +notify(result)
    }
    class JobInterface {
        -jobController
        +display(message)
        +notify(result)
    }
    class InvoiceInterface {
        -invoiceController
        +display(message)
        +notify(result)
    }
    class PaymentInterface {
        -paymentController
        +display(message)
        +notify(result)
    }
    class HistoryInterface {
        -historyController
        +display(message)
        +notify(result)
    }

    %% Controller classes
    class LoginController {
        -dbHandler
        +submitLogin(data)
        +checkStatusIsActive()
        +verifyPassword()
        +loginCustomer()
    }
    class JobController {
        -dbHandler
        +submitRequest(data)
        +generateJobIdAndRequestDate()
        +getSurveyJobs()
        +submitSurvey(data)
        +submitExpenses(data)
        +getQuotation(job)
        +approveQuotation(job)
        +notifyStaff()
        +getTodayJobs()
        +startJob(job)
        +completeJob(job)
        +getJob(job)
        +acceptJob(job)
        +notifyAccountant()
    }
    class RegisterController {
        -dbHandler
        +submitRegister(data)
    }
    class CustomerController {
        -dbHandler
        -emailService
        +getPendingCustomers()
        +approveCustomer(customer)
    }
    class QuotationController {
        -dbHandler
        +getSurveyedJobs()
        +getQuotationData(job)
        +submitQuotation(fee)
        +generateQuotationIdAndPdf()
    }
    class WorkPlanController {
        -dbHandler
        +getApprovedJobs()
        +submitWorkPlan(data)
        +generatePlanId()
        +getDraftPlans()
        +approvePlan(plan)
    }
    class MaterialController {
        -dbHandler
        +getPlanItems(job)
        +checkStock(items)
        +compareStockWithRequiredQuantity()
    }
    class PurchaseController {
        -dbHandler
        +getPurchaseRequests()
        +receiveStock(data)
    }
    class SafetyCheckController {
        -dbHandler
        -emailService
        +submitSafetyCheck(results)
        +checkAllItemsPassed()
    }
    class InvoiceController {
        -dbHandler
        -emailService
        +getAcceptedJobs()
        +getInvoiceData(job)
        +createInvoice(data)
        +generateInvoiceId()
    }
    class PaymentController {
        -dbHandler
        +getUnpaidJobs()
        +getExpenses(job)
        +submitPayment(data)
    }
    class HistoryController {
        -dbHandler
        +getPaidJobs()
        +getJobSummary(job)
        +saveHistory(job, note)
    }

    %% Handler classes
    class DatabaseHandler {
        +findCustomer(username)
        +saveInstallationJob(job)
        +saveCustomer(customer, status)
        +findCustomers(status)
        +updateStatus(customer, status)
        +findJobs(status)
        +saveSurvey(survey, status)
        +saveExpenses(expenses)
        +findQuotationData(job)
        +saveQuotation(quotation)
        +findQuotation(job)
        +updateJobStatus(status)
        +saveWorkPlan(plan, status)
        +findWorkPlans(status)
        +findPlanItems(job)
        +findStock(items)
        +findPurchaseRequests()
        +updateStock(material, quantity)
        +findTodayJobs(technician)
        +updateJob(status, time)
        +saveEndTime(job)
        +findJob(job)
        +findApprovedQuotation(job)
        +saveInvoice(status)
        +findExpenses(job)
        +savePayment(payment, receipt, status)
        +findJobSummary(job)
        +saveHistory(job, note)
        +closeJob(job)
    }
    class EmailService {
        +sendApprovalEmail(customer)
        +sendAcceptanceEmail(customer)
        +sendInvoiceEmail(customer)
    }

    %% Entity classes
    class Customer {
        -customerId
        -username
        -password
        -customerName
        -customerPhone
        -status
    }
    class Employee {
        -employeeId
        -username
        -password
        -employeeName
        -role
    }
    class Job {
        -jobId
        -jobType
        -requestDate
        -jobAddress
        -jobWage
        -status
    }
    class Survey {
        -surveyId
        -surveyDate
        -note
    }
    class Expense {
        -expenseId
        -expenseName
        -quantity
        -price
    }
    class Quotation {
        -quotationId
        -fileData
        -totalAmount
        -status
        -rejectNote
    }
    class WorkPlan {
        -planId
        -location
        -startDate
        -endDate
        -status
    }
    class WorkPlanMaterial {
        -planId
        -materialId
        -quantity
    }
    class Material {
        -materialId
        -materialName
        -price
        -stockQuantity
    }
    class Receipt {
        -receiptId
        -totalAmount
        -status
    }
    class Payment {
        -paymentId
        -paymentDate
        -amount
        -paymentMethod
        -slipUrl
        -verified
    }

    %% Association: interface has controller
    LoginInterface "1" --> "1" LoginController : has
    RequestInterface "1" --> "1" JobController : has
    RegisterInterface "1" --> "1" RegisterController : has
    CustomerApprovalInterface "1" --> "1" CustomerController : has
    SurveyInterface "1" --> "1" JobController : has
    QuotationInterface "1" --> "1" QuotationController : has
    QuotationInterface "1" --> "1" JobController : has
    WorkPlanInterface "1" --> "1" WorkPlanController : has
    MaterialInterface "1" --> "1" MaterialController : has
    PurchaseInterface "1" --> "1" PurchaseController : has
    TechnicianJobInterface "1" --> "1" JobController : has
    SafetyCheckInterface "1" --> "1" SafetyCheckController : has
    JobInterface "1" --> "1" JobController : has
    InvoiceInterface "1" --> "1" InvoiceController : has
    PaymentInterface "1" --> "1" PaymentController : has
    HistoryInterface "1" --> "1" HistoryController : has

    %% Association: controller has handler
    LoginController "1" --> "1" DatabaseHandler : has
    JobController "1" --> "1" DatabaseHandler : has
    RegisterController "1" --> "1" DatabaseHandler : has
    CustomerController "1" --> "1" DatabaseHandler : has
    QuotationController "1" --> "1" DatabaseHandler : has
    WorkPlanController "1" --> "1" DatabaseHandler : has
    MaterialController "1" --> "1" DatabaseHandler : has
    PurchaseController "1" --> "1" DatabaseHandler : has
    SafetyCheckController "1" --> "1" DatabaseHandler : has
    InvoiceController "1" --> "1" DatabaseHandler : has
    PaymentController "1" --> "1" DatabaseHandler : has
    HistoryController "1" --> "1" DatabaseHandler : has
    CustomerController "1" --> "1" EmailService : has
    SafetyCheckController "1" --> "1" EmailService : has
    InvoiceController "1" --> "1" EmailService : has

    %% Aggregation: entity holds many entities
    Customer "1" o-- "*" Job : have
    Job "1" o-- "*" Survey : have
    Job "1" o-- "*" Expense : have
    Employee "1" o-- "*" Survey : have
    Employee "1" o-- "*" Receipt : have
    Survey "1" o-- "*" WorkPlan : have
    WorkPlan "1" o-- "*" WorkPlanMaterial : have
    Material "1" o-- "*" WorkPlanMaterial : have
    Receipt "1" o-- "*" Payment : have

